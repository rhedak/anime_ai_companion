{
  "name": "anaico-desktop",
  "version": "0.12.1",
  "productName": "Anime AI Companion",
  "private": true,
  "description": "Desktop shell for Anime AI Companion: starts the app's own server and shows its page in a window.",
  "author": "Henrik Hanssen",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage.mjs",
    "dist": "npm run stage && electron-builder --win",
    "dist:linux": "npm run stage && electron-builder --linux --x64 --arm64",
    "dist:mac": "npm run stage && electron-builder --mac --x64 --arm64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.rhedak.anaico",
    "productName": "Anime AI Companion",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "update-check.cjs", "package.json", "build/icon.png"],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      { "from": "stage/anaico-app", "to": "anaico-app" },
      { "from": "stage/creator", "to": "creator" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "mac": { "target": ["dmg", "zip"], "icon": "build/icon.png", "category": "public.app-category.entertainment", "identity": "-" },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Utility", "synopsis": "A local anime companion", "executableName": "anaico", "desktop": { "entry": { "StartupWMClass": "anime-ai-companion" } } },
    "dmg": { "title": "Anime AI Companion" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
