#!/usr/bin/env bash
# Installed with ./check.sh --install-hook. Runs check.sh before a push, and for a push to main (a release) its --full set.
# It tests what is checked out, so it refuses to let you push a different commit than HEAD.
set -euo pipefail
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
need=0 full=0
while read -r lref lsha rref _; do
  [ "$lsha" = "$zero" ] && continue              # deleting a remote branch or tag
  case "$lref" in refs/heads/*) need=1 ;; *) continue ;; esac   # a tag alone has nothing new to test
  if [ "$lsha" != "$head" ]; then
    echo "pre-push: you are pushing $lref ($lsha) but HEAD is $head. Check it out, so check.sh tests what is pushed." >&2
    exit 1
  fi
  [ "$rref" = refs/heads/main ] && full=1
done
[ "$need" = 1 ] || exit 0
if [ "$full" = 1 ]; then exec "$(git rev-parse --show-toplevel)/check.sh" --full; fi
exec "$(git rev-parse --show-toplevel)/check.sh"
