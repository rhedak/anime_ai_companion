{
  "name": "anime-ai-companion",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A local browser-based anime AI companion, drawn by code and driven by a headless Claude Code session",
  "license": "MIT",
  "author": "Henrik Hanssen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhedak/anime_ai_companion.git"
  },
  "homepage": "https://github.com/rhedak/anime_ai_companion",
  "bugs": "https://github.com/rhedak/anime_ai_companion/issues",
  "keywords": [
    "anime",
    "ai-companion",
    "claude-code",
    "svg",
    "llm",
    "avatar"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "anaico": "bin/anaico.js"
  },
  "creator": {
    "url": "https://github.com/rhedak/anime-character-creator.git",
    "ref": "v0.4.0"
  },
  "scripts": {
    "start": "node bin/check-node.js && node src/server.ts",
    "open": "node bin/check-node.js && node src/server.ts --open",
    "dev": "node bin/check-node.js && node --watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p tsconfig.demo.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "site": "node site/build.mjs",
    "site:preview": "node bin/check-node.js && node site/preview.mjs",
    "demo": "node bin/check-node.js && node demo/stage.mjs --serve",
    "pack-archive": "node src/pack-archive-cli.ts"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "marked": "^18.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0"
  }
}
